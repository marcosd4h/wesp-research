<?xml version="1.0" encoding="utf-8"?>
<esptool>
  <client name="esptool-filt-proccmd" altitude="385000"/>
  <rules>
    <rule name="proc-image-nt-cmd" event="ProcessCreate" eventType="1000"
          lifetime="transient" action="1">
      <filter type="10" comparand="1" operand="0" property="1"
              propertyName="imagePath" op="equals"
              value="$nt:C:\Windows\System32\cmd.exe"/>
    </rule>
  </rules>
</esptool>
